---
import "../styles/global.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteName = "プロップFXナビ";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-site-verification" content="vspcknzdfBrq3vyLsAETonwy1-hwOWIO_Xg5_xwLME0" />
  <meta name="google-site-verification" content="1THrXsxCk_MNEipowwWUfA4V6I3YNTs4jP4DmRzEdt0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href={url("/")} class="logo">プロップ<span>FXナビ</span></a>
      <nav>
        <a href={url("/prop/")}>プロップ一覧</a>
        <a href={url("/prop/ranking/")}>ランキング</a>
        <a href={url("/prop/compare/")}>比較</a>
        <a href={url("/guide/")}>入門ガイド</a>
        <a href={url("/about/")}>運営者</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="links">
        <a href={url("/about/")}>運営者情報</a>
        <a href={url("/disclosure/")}>広告開示</a>
        <a href={url("/privacy/")}>プライバシーポリシー</a>
        <a href={url("/contact/")}>お問い合わせ</a>
      </div>
      <div>&copy; 2026 プロップFXナビ. 当サイトはアフィリエイトプログラムに参加しています.</div>
    </div>
  </footer>
</body>
</html>
