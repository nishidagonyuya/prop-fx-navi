---
import "../styles/global.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical } = Astro.props;
const siteName = "プロップFXナビ";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="google-site-verification" content="vspcknzdfBrq3vyLsAETonwy1-hwOWIO_Xg5_xwLME0" />
  <meta name="google-site-verification" content="1THrXsxCk_MNEipowwWUfA4V6I3YNTs4jP4DmRzEdt0" />
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MWW288DV3L"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-MWW288DV3L');
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href={url("/")} class="logo">プロップ<span>FXナビ</span></a>
      <nav>
        <a href={url("/prop/")}>一覧</a>
        <a href={url("/prop/ranking/")}>ランキング</a>
        <a href={url("/prop/compare/")}>比較</a>
        <a href={url("/coupon/")}>クーポン</a>
        <a href={url("/guide/")}>ガイド</a>
        <a href={url("/roadmap/")}>始め方</a>
        <a href={url("/faq/")}>FAQ</a>
        <a href={url("/about/")}>運営者</a>
      </nav>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="links">
        <a href={url("/about/")}>運営者情報</a>
        <a href={url("/guide/kaizen-corp/")}>株式会社KAIZEN</a>
        <a href={url("/guide/miyagi-gai-profile/")}>宮城ガイ</a>
        <a href={url("/guide/university-of-money/")}>University of Money</a>
      </div>
      <div style="margin-top:14px; line-height:1.7;">
        運営：<strong style="color:var(--text);">株式会社KAIZEN</strong>（代表取締役：西田侑矢／代表講師：宮城ガイ／<a href="https://miraijob.jp/" target="_blank" rel="noopener">miraijob.jp</a>）<br/>
        <span style="font-size:0.82rem;">&copy; 2026 プロップFXナビ. 当サイトはアフィリエイトプログラムに参加しています.</span>
      </div>
    </div>
  </footer>
</body>
</html>
