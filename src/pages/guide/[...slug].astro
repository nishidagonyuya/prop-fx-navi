---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import { getCollection, render } from "astro:content";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// 宮城ガイ プロフィールページ自身には監修バイラインを出さない
const isProfilePage = guide.id === "miyagi-gai-profile";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishedAt,
  dateModified: guide.data.updatedAt,
  author: {
    "@type": "Person",
    name: "宮城ガイ",
    jobTitle: "運用マネージャー／FXスクール代表講師",
    description:
      "現役の運用会社マネージャー。国際認定テクニカルアナリスト。FXスクール『University of Money』代表講師。",
    url: "https://propfxnavi.com/guide/miyagi-gai-profile/",
    worksFor: { "@type": "Organization", name: "株式会社KAIZEN" },
    sameAs: [
      "https://www.youtube.com/@fxschool-gai",
      "https://stand.fm/channels/65c393410a4a74f98fbf4b35",
      "https://open.spotify.com/show/033ojAuBUgjSG4IhTayCSl",
      "https://note.com/miyagi_gai",
    ],
  },
  publisher: {
    "@type": "Organization",
    name: "プロップFXナビ（株式会社KAIZEN）",
    url: "https://propfxnavi.com/",
  },
};

// FAQ がある記事は FAQPage 構造化データを追加（リッチリザルト用）
const faqs = guide.data.faqs ?? [];
const faqJsonLd = faqs.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

// パンくず構造化データ（SERPでパンくず表示）
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: "https://propfxnavi.com/" },
    { "@type": "ListItem", position: 2, name: "入門ガイド", item: "https://propfxnavi.com/guide/" },
    { "@type": "ListItem", position: 3, name: guide.data.title, item: `https://propfxnavi.com/guide/${guide.id}/` },
  ],
};

// トピッククラスター：related 指定があれば優先、無ければ order 順で補完
const allGuides = await getCollection("guides");
const byId = new Map(allGuides.map((g) => [g.id, g]));
const relatedManual = (guide.data.related ?? [])
  .map((id) => byId.get(id))
  .filter((g) => g && g.id !== guide.id);
const fallback = allGuides
  .filter((g) => g.id !== guide.id && !relatedManual.some((r) => r!.id === g.id))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const otherGuides = [...relatedManual, ...fallback].slice(0, 6);
---
<BaseLayout title={guide.data.title} description={guide.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <section class="hero" style="padding-bottom:30px;">
    <div class="container" style="max-width:760px;">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href={url("/")}>ホーム</a>
        <span class="sep">›</span>
        <a href={url("/guide/")}>入門ガイド</a>
        <span class="sep">›</span>
        <span class="current">{guide.data.title}</span>
      </nav>
      <div style="font-size:0.82rem; color:var(--text-muted); margin-bottom:12px;">更新日 {guide.data.updatedAt}</div>
      <h1 style="font-size:clamp(1.5rem, 3vw, 2.2rem); line-height:1.4; text-align:left;">{guide.data.title}</h1>
      <p style="text-align:left; color:var(--text-muted); margin-top:14px;">{guide.data.description}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container article-content" style="max-width:760px;">
      {!isProfilePage && <AuthorBox variant="compact" updatedAt={guide.data.updatedAt} />}
      <Content />

      {faqs.length > 0 && (
        <div class="article-faq">
          <h2 id="faq">よくある質問（FAQ）</h2>
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <p set:html={f.a} />
            </details>
          ))}
        </div>
      )}

      {!isProfilePage && <AuthorBox variant="full" />}
      <p class="article-disclaimer">
        ※本記事は情報提供を目的としたものであり、特定の金融商品の勧誘・投資助言を目的とするものではありません。プロップファームの利用やトレードは自己責任で行ってください。税務・法務など個別の判断は専門家にご相談ください。当サイトはアフィリエイトプログラムに参加しており、記事内のリンクから登録された場合に紹介料を受け取ることがあります。
      </p>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container">
      <h2 style="font-size:1.4rem; margin-bottom:20px;">他のガイドも読む</h2>
      <div class="prop-grid">
        {otherGuides.map((g) => (
          <a class="prop-card" href={url(`/guide/${g.id}/`)}>
            <div class="head">
              <div class="name" style="font-size:1.0rem; line-height:1.4;">{g.data.title}</div>
            </div>
            <div class="tagline">{g.data.description}</div>
            <div class="cta">記事を読む →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .article-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .article-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 28px 0 12px;
    color: var(--accent);
  }
  .article-content p {
    margin: 14px 0;
    line-height: 1.85;
  }
  .article-content ul, .article-content ol {
    margin: 14px 0 14px 1.4em;
    line-height: 1.85;
  }
  .article-content li {
    margin: 4px 0;
  }
  .article-content blockquote {
    border-left: 4px solid var(--accent);
    background: var(--card);
    padding: 14px 20px;
    margin: 20px 0;
    border-radius: 0 8px 8px 0;
    color: var(--text-muted);
  }
  .article-content a {
    color: var(--accent);
    text-decoration: underline;
  }
  .article-content strong {
    color: var(--text);
    font-weight: 700;
  }
  .article-content code {
    background: var(--bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
  }
  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    background: var(--card);
    border-radius: 10px;
    overflow: hidden;
  }
  .article-content th, .article-content td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .article-content th {
    background: var(--bg-soft);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .article-faq { margin: 40px 0 8px; }
  .article-faq h2 {
    font-size: 1.5rem; font-weight: 700; margin: 0 0 16px;
    padding-bottom: 8px; border-bottom: 1px solid var(--border); color: var(--text);
  }
  .faq-item {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; margin: 10px 0; overflow: hidden;
  }
  .faq-item summary {
    cursor: pointer; padding: 14px 18px; font-weight: 700;
    font-size: 0.96rem; color: var(--text); list-style: none; position: relative;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: "＋"; position: absolute; right: 18px; color: var(--accent); font-weight: 700;
  }
  .faq-item[open] summary::after { content: "−"; }
  .faq-item p {
    margin: 0; padding: 0 18px 16px; line-height: 1.85;
    color: var(--text-muted); font-size: 0.92rem;
  }
  .faq-item p a { color: var(--accent); }
  .article-disclaimer {
    margin-top: 22px;
    padding: 14px 16px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 0.78rem;
    line-height: 1.8;
    color: var(--text-muted);
  }
</style>
