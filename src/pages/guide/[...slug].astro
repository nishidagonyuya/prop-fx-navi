---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.publishedAt,
  dateModified: guide.data.updatedAt,
  author: { "@type": "Organization", name: "プロップFXナビ" },
  publisher: { "@type": "Organization", name: "プロップFXナビ" },
};

const otherGuides = (await getCollection("guides"))
  .filter((g) => g.id !== guide.id)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 6);
---
<BaseLayout title={guide.data.title} description={guide.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero" style="padding-bottom:30px;">
    <div class="container" style="max-width:760px;">
      <div style="font-size:0.85rem; color:var(--text-muted); margin-bottom:12px;">
        <a href={url("/guide/")} style="color:var(--text-muted);">入門ガイド</a> ／ 更新日 {guide.data.updatedAt}
      </div>
      <h1 style="font-size:clamp(1.5rem, 3vw, 2.2rem); line-height:1.4; text-align:left;">{guide.data.title}</h1>
      <p style="text-align:left; color:var(--text-muted); margin-top:14px;">{guide.data.description}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="container article-content" style="max-width:760px;">
      <Content />
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container">
      <h2 style="font-size:1.4rem; margin-bottom:20px;">他のガイドも読む</h2>
      <div class="prop-grid">
        {otherGuides.map((g) => (
          <a class="prop-card" href={url(`/guide/${g.id}/`)}>
            <div class="head">
              <div class="name" style="font-size:1.0rem; line-height:1.4;">{g.data.title}</div>
            </div>
            <div class="tagline">{g.data.description}</div>
            <div class="cta">記事を読む →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .article-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 40px 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .article-content h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 28px 0 12px;
    color: var(--accent);
  }
  .article-content p {
    margin: 14px 0;
    line-height: 1.85;
  }
  .article-content ul, .article-content ol {
    margin: 14px 0 14px 1.4em;
    line-height: 1.85;
  }
  .article-content li {
    margin: 4px 0;
  }
  .article-content blockquote {
    border-left: 4px solid var(--accent);
    background: var(--card);
    padding: 14px 20px;
    margin: 20px 0;
    border-radius: 0 8px 8px 0;
    color: var(--text-muted);
  }
  .article-content a {
    color: var(--accent);
    text-decoration: underline;
  }
  .article-content strong {
    color: var(--text);
    font-weight: 700;
  }
  .article-content code {
    background: var(--bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.9em;
  }
  .article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    background: var(--card);
    border-radius: 10px;
    overflow: hidden;
  }
  .article-content th, .article-content td {
    padding: 10px 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    font-size: 0.92rem;
  }
  .article-content th {
    background: var(--bg-soft);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
  }
</style>
